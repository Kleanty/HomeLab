#!/usr/bin/env bash
# Her 10 dakikada bir çalışır; yeni sorun çıkınca ve düzelince ntfy ile haber verir (tekrar tekrar uyarmaz).
set -uo pipefail
STATE_DIR=/var/lib/homelab-installer
STATE="$STATE_DIR/health-state"
NOTIFY=/usr/local/sbin/homelab-notify
install -d -m 0700 "$STATE_DIR"
declare -A NOW=()
add_problem() { NOW["$1"]="$2"; }

# 1) Disk doluluğu
declare -A SEEN_MOUNT=()
MAX_USE=0; MAX_MP=/
for MP in / /srv/homelab; do
  TARGET="$(df -P "$MP" 2>/dev/null | awk 'NR==2 {print $6}')"
  [[ -n "$TARGET" && -z "${SEEN_MOUNT[$TARGET]:-}" ]] || continue
  SEEN_MOUNT["$TARGET"]=1
  USE="$(df -P "$MP" 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')"
  if [[ "$USE" =~ ^[0-9]+$ ]] && ((USE > MAX_USE)); then MAX_USE=$USE; MAX_MP=$MP; fi
  if [[ "$USE" =~ ^[0-9]+$ ]] && ((USE >= 90)); then add_problem "disk:$TARGET" "Disk %$USE dolu: $TARGET"; fi
done
DISK_SIZE="$(df -P -BG "$MAX_MP" 2>/dev/null | awk 'NR==2 {gsub("G","",$2); gsub("G","",$3); print $3 " / " $2 " GB"}')"
# 2) Başarısız systemd birimleri
while read -r UNIT; do
  [[ -n "$UNIT" ]] && add_problem "unit:$UNIT" "Servis başarısız: $UNIT"
done < <(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}')
# 3) Bilinen konteynerler çalışmıyor
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  for C in dockge beszel beszel-agent uptime-kuma scrutiny filebrowser ollama n8n caddy adguardhome ntfy; do
    STATUS="$(docker inspect --format '{{.State.Status}}' "$C" 2>/dev/null || true)"
    [[ -n "$STATUS" && "$STATUS" != running ]] && add_problem "container:$C" "Konteyner çalışmıyor: $C ($STATUS)"
  done
fi
# 4) İnternet (ping) ve kendi servislerin yanıtı
PING_MS=""
if command -v ping >/dev/null 2>&1; then
  for HOST in 1.1.1.1 8.8.8.8; do
    PING_MS="$(ping -n -q -c 3 -W 2 "$HOST" 2>/dev/null | awk -F'[/ =]+' '/^(rtt|round-trip)/ {print int($7)}')"
    [[ -n "$PING_MS" ]] && break
  done
  if [[ -z "$PING_MS" ]]; then add_problem "internet:down" "İnternet bağlantısı yok"
  elif ((PING_MS > 250)); then add_problem "internet:slow" "İnternet yavaş: ping $PING_MS ms"; fi
fi
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  for SVC in dockge:5001 beszel:8090 uptime-kuma:3001 filebrowser:8080 n8n:5678 scrutiny:8081 caddy:8088 ntfy:2586; do
    NAME="${SVC%%:*}"; PORT="${SVC##*:}"
    [[ "$(docker inspect --format '{{.State.Status}}' "$NAME" 2>/dev/null || true)" == running ]] || continue
    curl -s -o /dev/null --max-time 5 "http://127.0.0.1:$PORT/" || add_problem "service:$NAME" "Servis yanıt vermiyor: $NAME (:$PORT)"
  done
fi
# 5) Yedek 48 saatten eski
if [[ -f /etc/restic/homelab.env ]]; then
  LAST="$(systemctl show homelab-restic-backup.service -p ExecMainExitTimestamp --value 2>/dev/null || true)"
  if [[ -n "$LAST" ]]; then
    LAST_EPOCH="$(date -d "$LAST" +%s 2>/dev/null || echo 0)"
    if ((LAST_EPOCH > 0)) && (( $(date +%s) - LAST_EPOCH > 172800 )); then add_problem "backup:stale" "Son yedek 48 saatten eski ($LAST)"; fi
  fi
fi

BACKUP_TEXT="Kurulu değil"; BACKUP_LEVEL=""
if [[ -f /etc/restic/homelab.env ]]; then
  BACKUP_TEXT="Zamanı bilinmiyor"; BACKUP_LEVEL="warn"
  if [[ -n "${LAST:-}" ]] && ((${LAST_EPOCH:-0} > 0)); then
    AGE_H=$(( ($(date +%s) - LAST_EPOCH) / 3600 ))
    BACKUP_TEXT="$AGE_H saat önce"; BACKUP_LEVEL="ok"
    (( AGE_H > 48 )) && BACKUP_LEVEL="error"
  fi
fi

declare -A OLD=()
if [[ -f "$STATE" ]]; then
  while IFS='|' read -r KEY MSG; do [[ -n "$KEY" ]] && OLD["$KEY"]="$MSG"; done < "$STATE"
fi
declare -A NEW=()
HISTORY="$STATE_DIR/health-history"   # epoch|AÇILDI|ÇÖZÜLDÜ|mesaj (son 200 kayıt)
log_event() { printf '%s|%s|%s\n' "$(date +%s)" "$1" "$2" >> "$HISTORY"; }
for KEY in "${!NOW[@]}"; do
  if [[ -n "${OLD[$KEY]:-}" ]]; then
    NEW["$KEY"]="${NOW[$KEY]}"
  else
    PRIO=4; [[ "$KEY" == internet:down || "$KEY" == service:* ]] && PRIO=5
    if "$NOTIFY" "HomeLab: sorun" "${NOW[$KEY]}" "$PRIO" warning; then
      NEW["$KEY"]="${NOW[$KEY]}"; log_event AÇILDI "${NOW[$KEY]}"
    fi   # bildirim gitmediyse kaydetme; sonraki çalıştırmada tekrar denenir
  fi
done
for KEY in "${!OLD[@]}"; do
  if [[ -z "${NOW[$KEY]:-}" ]]; then
    if "$NOTIFY" "HomeLab: düzeldi" "${OLD[$KEY]} — sorun giderildi" 3 white_check_mark; then log_event ÇÖZÜLDÜ "${OLD[$KEY]}"; else NEW["$KEY"]="${OLD[$KEY]}"; fi
  fi
done
if [[ -f "$HISTORY" ]]; then tail -n 200 "$HISTORY" > "$HISTORY.tmp" && mv -f "$HISTORY.tmp" "$HISTORY"; chmod 0600 "$HISTORY"; fi
TMP="$(mktemp "$STATE_DIR/.health.XXXXXX")"
for KEY in "${!NEW[@]}"; do printf '%s|%s\n' "$KEY" "${NEW[$KEY]}" >> "$TMP"; done
chmod 0600 "$TMP"; mv -f "$TMP" "$STATE"

# HomeLab telefon paneline durum değerleri (ajan yoksa sessizce atlanır; değerler 30 dk sonra kendiliğinden silinir).
push_phone() { # anahtar JSON
  curl -fsS --max-time 3 -H "Content-Type: application/json" -d "$2" "http://127.0.0.1:8765/api/push/$1?ttl=1800" >/dev/null 2>&1
}
if curl -fsS --max-time 2 http://127.0.0.1:8765/api/info >/dev/null 2>&1; then
  PROBLEMS=${#NOW[@]}
  DISK_LEVEL=ok; ((MAX_USE >= 80)) && DISK_LEVEL=warn; ((MAX_USE >= 90)) && DISK_LEVEL=error
  HEALTH_TXT="Sorun yok"; HEALTH_LVL=ok
  ((PROBLEMS > 0)) && { HEALTH_TXT="$PROBLEMS sorun"; HEALTH_LVL=error; }
  NET_TXT="Yok"; NET_LVL=error
  if [[ -n "$PING_MS" ]]; then NET_TXT="ping $PING_MS ms"; NET_LVL=ok; ((PING_MS > 250)) && NET_LVL=warn; fi
  [[ -z "$PING_MS" ]] && ! command -v ping >/dev/null 2>&1 && { NET_TXT="Ölçülemedi"; NET_LVL=warn; }
  CONT_TXT="Okunamadı"; CONT_LVL=warn; TS_TXT="Kurulu değil"; TS_LVL=""
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    RUNNING="$(docker ps -q 2>/dev/null | wc -l)"
    DOWN="$(docker ps -a --filter status=exited --filter status=dead --filter status=restarting --format '{{.Names}}' 2>/dev/null | paste -sd, - | cut -c1-60)"
    CONT_TXT="$RUNNING çalışıyor"; CONT_LVL=ok
    [[ -n "$DOWN" ]] && { CONT_TXT="$RUNNING çalışıyor, kapalı: $DOWN"; CONT_LVL=error; }
  fi
  if command -v tailscale >/dev/null 2>&1; then
    TS_TXT="Okunamadı"; TS_LVL=warn
    TS_OUT="$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin); n=sum(1 for p in (d.get("Peer") or {}).values() if p.get("Online"))
    print(("ok|Bağlı, " if d.get("BackendState")=="Running" else "warn|Bağlı değil, ")+str(n)+" cihaz çevrimiçi")
except Exception:
    pass' || true)"
    [[ -n "$TS_OUT" ]] && { TS_LVL="${TS_OUT%%|*}"; TS_TXT="${TS_OUT#*|}"; }
  fi
  push_phone homelab-status "$(python3 -c 'import json,sys
a=sys.argv[1:]
names=["Durum","Konteynerler","Disk","İnternet","Son yedek","Tailscale"]
items=[]
for i,n in enumerate(names):
    it={"label":n,"value":a[2*i]}
    if a[2*i+1]: it["level"]=a[2*i+1]
    items.append(it)
print(json.dumps({"items":items}))' "$HEALTH_TXT" "$HEALTH_LVL" "$CONT_TXT" "$CONT_LVL" "%$MAX_USE${DISK_SIZE:+ · $DISK_SIZE}" "$DISK_LEVEL" "$NET_TXT" "$NET_LVL" "$BACKUP_TEXT" "$BACKUP_LEVEL" "$TS_TXT" "$TS_LVL")" || true
  # Uyarılar sayfası: şu an açık olanlar ve son kayıtlar (en yenisi üstte)
  push_phone homelab-alerts-now "$(python3 -c 'import json,sys
msgs=[m for m in sys.argv[1:] if m]
items=[{"label":m,"value":"AÇIK","level":"error"} for m in msgs] or [{"label":"Şu an sorun yok","value":"✓","level":"ok"}]
print(json.dumps({"items":items}))' "${NOW[@]}")" || true
  push_phone homelab-alerts-history "$(python3 -c 'import json,sys,time
rows=[]
try:
    for line in open(sys.argv[1],encoding="utf-8"):
        p=line.rstrip("\n").split("|",2)
        if len(p)==3 and p[0].isdigit(): rows.append(p)
except OSError:
    pass
items=[]
for ts,ev,msg in reversed(rows[-14:]):
    items.append({"label":time.strftime("%d.%m %H:%M",time.localtime(int(ts)))+"  "+msg,"value":ev,"level":"error" if ev=="AÇILDI" else "ok"})
print(json.dumps({"items":items or [{"label":"Kayıt yok","value":""}]}))' "$HISTORY")" || true
fi
